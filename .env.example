# Choose one LLM provider and set its key. Used only for local development, since
# the deployed app is bring-your-own-key (each visitor enters their own in the UI).
# LLM_PROVIDER is one of: anthropic, openai, groq
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional: overrides the default Groq model (agent/llm.py) without a code
# change, useful when Groq deprecates the current default. Leave blank to
# use the built-in default.
GROQ_MODEL=

# LangSmith tracing (optional but recommended). Free key: https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=charity-due-diligence-agent

# Optional: locks the API behind a bearer token. Leave blank for an open local demo.
API_AUTH_TOKEN=

# UI -> API wiring
API_BASE_URL=http://localhost:8000

# CORS, comma-separated origins, "*" for a local demo
CORS_ORIGINS=*
